<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>دعوة زفاف حسن وأمنيَة</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Amiri:wght@400;700&display=swap">
<style>
:root{
  --img:url("data:image/jpeg;base64,");
  --night:#1b1020; --rose:#c43d56; --gold:#ecc67f; --cream:#fbf0e4; --mist:#d9c3c8;
  color-scheme:dark;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--night);color:var(--cream);
  font-family:"Amiri","Traditional Arabic",serif;font-size:19px;line-height:1.9;overflow-x:hidden}
body.locked{overflow:hidden;height:100%}
.ruq{font-family:"Aref Ruqaa","Amiri",serif}

/* ---------- الدخلة ---------- */
.gate{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;overflow:hidden;
  background:radial-gradient(ellipse at 50% 55%,#2c1330 0%,#0d060f 72%);transition:background 1s ease}
.gate.out{opacity:0;visibility:hidden;transition:opacity 1.6s ease,visibility 0s 1.6s}
.gate.go{background:transparent}
.dust{position:absolute;inset:0;pointer-events:none}
.dust i{position:absolute;width:3px;height:3px;border-radius:50%;background:var(--gold);opacity:0;animation:dust 6s ease-in-out infinite}
@keyframes dust{0%{opacity:0;transform:translateY(14px)}40%{opacity:.8}100%{opacity:0;transform:translateY(-34px)}}
.line{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center;padding:0 28px;
  font-size:clamp(28px,8.2vw,46px);line-height:1.7;color:var(--cream);opacity:0;filter:blur(10px);
  transition:opacity 1.5s ease,filter 1.5s ease}
.line.on{opacity:1;filter:none}
.stage{display:flex;flex-direction:column;align-items:center;gap:26px}
.hw{width:min(44vw,190px);opacity:0;transform:scale(.15);
  transition:opacity 1.2s ease,transform 1.6s cubic-bezier(.2,1.4,.4,1)}
.hw.on{opacity:1;transform:scale(1)}
.gate.go .hw{transform:scale(110);opacity:1;transition:transform 1.9s cubic-bezier(.6,0,.95,.5)}
.hw svg{display:block;width:100%;filter:drop-shadow(0 0 22px rgba(196,61,86,.9));animation:beat 1.15s ease-in-out infinite}
@keyframes beat{0%,100%{transform:scale(1)}14%{transform:scale(1.14)}28%{transform:scale(1)}42%{transform:scale(1.1)}}
.hn{font-size:clamp(40px,12vw,64px);color:var(--gold);opacity:0;transition:opacity 1.4s ease;line-height:1.3}
.hn.on{opacity:1}
.gate.go .hn{opacity:0;transition:opacity .4s}
.skip{position:absolute;left:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));background:none;border:0;color:rgba(251,240,228,.5);
  font:inherit;font-size:17px;padding:10px 14px;cursor:pointer;z-index:2}
.skip:focus-visible{outline:2px solid var(--gold)}

/* ---------- المشهد: السحب بتتحرك ---------- */
.scene{position:relative;width:100%;max-width:1000px;margin:0 auto;aspect-ratio:1408/768;overflow:hidden;
  transform:scale(1.18);filter:brightness(.25);transition:transform 4s ease-out,filter 2.6s ease}
.show .scene{transform:none;filter:none}
.scene .base{position:absolute;inset:0;background:var(--img) center/100% 100% no-repeat}
.scene::after{content:"";position:absolute;left:0;right:0;bottom:0;height:34%;background:linear-gradient(transparent,var(--night))}

/* ---------- بتلات الورد ---------- */
.pl{position:fixed;inset:0;z-index:5;pointer-events:none;overflow:hidden}
.pt{position:absolute;top:-40px;animation:pfall linear infinite}
@keyframes pfall{to{transform:translateY(calc(100vh + 90px))}}
.pt i{display:block;width:var(--w);height:calc(var(--w)*1.3);border-radius:80% 0 80% 0;background:var(--c);
  box-shadow:inset -2px -3px 7px rgba(0,0,0,.2);animation:psway var(--sd) ease-in-out infinite alternate}
@keyframes psway{from{transform:translateX(-28px) rotate(-45deg) rotateX(0)}to{transform:translateX(28px) rotate(65deg) rotateX(70deg)}}

/* ---------- التعليقات ---------- */
.wish{max-width:460px;margin:50px auto 0;text-align:right}
.wish h3{margin:0 0 14px;font-size:30px;color:var(--gold);text-align:center;font-weight:700}
.wish form{display:grid;gap:10px}
.wish input,.wish textarea{width:100%;font:inherit;font-size:19px;color:var(--cream);background:rgba(251,240,228,.08);
  border:1px solid rgba(236,198,127,.4);border-radius:12px;padding:11px 14px}
.wish textarea{min-height:96px;resize:vertical}
.wish input:focus-visible,.wish textarea:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.wish ::placeholder{color:rgba(217,195,200,.7)}
.wish .btn{justify-self:center}
.wish .msg{text-align:center;color:var(--mist);font-size:17px;margin:10px 0 0}
.wlist{display:grid;gap:12px;margin-top:22px}
.wc{border-radius:14px;padding:12px 16px;background:rgba(196,61,86,.14);border:1px solid rgba(236,198,127,.25)}
.wc b{display:block;color:var(--gold);font-size:19px}
.wc p{margin:2px 0 0;font-size:18px;line-height:1.7;white-space:pre-wrap;overflow-wrap:anywhere}

/* ---------- الدعوة ---------- */
main{position:relative;margin-top:-17vw;padding:0 22px 56px;text-align:center}
@media(min-width:1000px){main{margin-top:-170px}}
.bism{color:var(--gold);font-size:22px;margin:0 0 6px}
.names{margin:0;font-weight:700;font-size:clamp(58px,19vw,104px);line-height:1.15;color:var(--cream);text-shadow:0 4px 30px rgba(196,61,86,.5)}
.names span{display:block}
.amp{font-family:"Amiri",serif;color:var(--rose);font-size:.46em;line-height:1;margin:2px 0;font-weight:400}
.verse{max-width:520px;margin:26px auto 0;color:var(--mist);font-size:19px}
.verse cite{display:block;font-style:normal;color:var(--gold);font-size:16px}
.divider{width:140px;height:1px;margin:34px auto;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.invite{max-width:460px;margin:0 auto;font-size:21px}
.events{display:grid;gap:18px;max-width:460px;margin:34px auto 0}
.ev{border:1px solid rgba(236,198,127,.55);border-radius:18px 18px 4px 18px;padding:22px 20px 20px;background:linear-gradient(160deg,rgba(196,61,86,.2),rgba(42,22,48,.7))}
.ev h2{margin:0;font-size:34px;color:var(--gold);font-weight:700}
.ev .day{font-size:23px;margin-top:4px}
.ev .date{font-size:30px;color:var(--cream);font-weight:700;line-height:1.5}
.ev p{margin:6px 0 0;color:var(--mist);font-size:19px;line-height:1.7}
.ev.main{background:linear-gradient(160deg,rgba(196,61,86,.42),rgba(42,22,48,.78));border-color:var(--gold);border-width:2px}
.btns{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:16px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:40px;border:1px solid var(--gold);color:var(--gold);
  background:transparent;font:inherit;font-size:18px;text-decoration:none;cursor:pointer;min-height:46px}
.btn.fill{background:var(--gold);color:#3a1020;font-weight:700}
.btn:focus-visible{outline:3px solid var(--cream);outline-offset:3px}
.count{margin:44px auto 0;max-width:440px}
.count h3{margin:0 0 12px;font-size:28px;color:var(--gold);font-weight:700}
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;direction:rtl}
.cd div{border-radius:14px;padding:12px 4px 8px;background:rgba(251,240,228,.07);border:1px solid rgba(236,198,127,.3)}
.cd b{display:block;font-size:34px;line-height:1.3;color:var(--cream)}
.cd span{font-size:16px;color:var(--mist)}
.close{margin-top:50px;font-size:25px;color:var(--cream)}
.close small{display:block;margin-top:6px;font-size:21px;color:var(--gold)}
.reveal{opacity:0;transform:translateY(22px);transition:opacity 1.2s ease,transform 1.2s ease}
.show .reveal{opacity:1;transform:none}
.show .r1{transition-delay:1.6s}.show .r2{transition-delay:2.2s}.show .r3{transition-delay:2.9s}.show .r4{transition-delay:3.4s}
.show .reveal:not(.r1):not(.r2):not(.r3):not(.r4){transition-delay:3.2s}
@media(prefers-reduced-motion:reduce){
  .dust i,.hw svg,.pt,.pt i{animation:none}
  .scene{transform:none;filter:none;transition:none}
  .reveal{opacity:1;transform:none;transition:none}
}
</style>
</head>
<body class="locked">

<!-- الدخلة -->
<div class="gate" id="gate">
  <div class="dust" id="dust"></div>
  <div class="line ruq" id="l1">في ليلةٍ من ليالي العمر…</div>
  <div class="line ruq" id="l2">قلبان اجتمعا على الحب،<br>ودعوتهما إليكم</div>
  <div class="stage">
    <div class="hw" id="hw">
      <svg viewBox="0 0 100 88" aria-hidden="true">
        <defs><radialGradient id="hg" cx="50%" cy="38%" r="70%"><stop offset="0" stop-color="#ffd9a0"/><stop offset=".45" stop-color="#e0506a"/><stop offset="1" stop-color="#9d2540"/></radialGradient></defs>
        <path d="M50 86C10 56 0 36 0 22C0 8 12 0 25 0C37 0 46 7 50 16C54 7 63 0 75 0C88 0 100 8 100 22C100 36 90 56 50 86Z" fill="url(#hg)"/>
      </svg>
    </div>
    <div class="hn ruq" id="hn">حسن وأمنيَة</div>
  </div>
  <button class="skip" id="skip" type="button">تخطي</button>
</div>

<!-- الدعوة -->
<div class="pl" id="pl"></div>
<div id="page">
  <div class="scene" aria-label="العروسان يشاهدان الغروب بين الجبال والورود">
    <div class="base"></div>
  </div>

  <main>
    <p class="bism ruq reveal r1">بسم الله الرحمن الرحيم</p>
    <h1 class="names ruq reveal r2"><span>حسن</span><span class="amp">&</span><span>أمنيَة</span></h1>
    <p class="verse reveal r3">ومن آياته أن خلق لكم من أنفسكم أزواجًا لتسكنوا إليها وجعل بينكم مودة ورحمة<cite>سورة الروم – ٢١</cite></p>

    <div class="divider"></div>

    <p class="invite reveal">يتشرف أهل العروسين بدعوتكم لمشاركتهم فرحتهم، وحضور ليلة الحنة وحفل الزفاف</p>

    <section class="events">
      <article class="ev reveal">
        <h2 class="ruq">ليلة الحنة</h2>
        <div class="day">يوم الثلاثاء</div>
        <div class="date">٢٧ أكتوبر ٢٠٢٦</div>
      </article>
      <article class="ev main reveal">
        <h2 class="ruq">حفل الزفاف</h2>
        <div class="day">يوم الخميس</div>
        <div class="date">٢٩ أكتوبر ٢٠٢٦</div>
        <p>قاعة قصر أبو عوف<br>ديرب نجم – أول طريق الزقازيق</p>
        <div class="btns">
          <a class="btn fill" href="https://maps.app.goo.gl/CZDLUUsdP1rqSzpN8?g_st=ic" target="_blank" rel="noopener">افتح الموقع على الخريطة</a>
        </div>
      </article>
    </section>

    <section class="count reveal">
      <h3 class="ruq" id="cdTitle">باقي على الفرح</h3>
      <div class="cd" id="cd">
        <div><b id="d">٠</b><span>يوم</span></div>
        <div><b id="h">٠</b><span>ساعة</span></div>
        <div><b id="m">٠</b><span>دقيقة</span></div>
        <div><b id="s">٠</b><span>ثانية</span></div>
      </div>
    </section>

    <section class="wish reveal" id="wish">
      <h3 class="ruq">اترك تهنئة للعروسين</h3>
      <form id="wf" hidden>
        <input id="wn" maxlength="40" placeholder="اسمك" autocomplete="name" required>
        <textarea id="wt" maxlength="300" placeholder="اكتب تهنئتك هنا…" required></textarea>
        <button class="btn fill" type="submit" id="wb">أرسل التهنئة</button>
      </form>
      <p class="msg" id="wm"></p>
      <div class="wlist" id="wl"></div>
    </section>

    <p class="close ruq reveal">وجودكم يكمّل فرحتنا<small>بانتظاركم</small></p>
  </main>
</div>

<script>
(function(){
  var gate=document.getElementById('gate'),page=document.getElementById('page'),timers=[],done=false;
  var dust=document.getElementById('dust');
  for(var i=0;i<30;i++){var s=document.createElement('i');s.style.left=Math.random()*100+'%';s.style.top=(20+Math.random()*70)+'%';
    s.style.animationDelay=(Math.random()*6)+'s';s.style.animationDuration=(5+Math.random()*4)+'s';dust.appendChild(s);}

  function at(ms,fn){timers.push(setTimeout(fn,ms));}
  function on(id,v){document.getElementById(id).classList[v?'add':'remove']('on');}

  function startPetals(){
    if(matchMedia('(prefers-reduced-motion:reduce)').matches)return;
    var L=document.getElementById('pl'),C=['#c43d56','#a32a43','#d9566e','#fff6ef','#f6e0e4','#ffffff'];
    for(var i=0;i<28;i++){
      var p=document.createElement('span');p.className='pt';
      p.style.left=(Math.random()*100)+'%';p.style.animationDuration=(9+Math.random()*9)+'s';p.style.animationDelay=(-Math.random()*14)+'s';
      var e=document.createElement('i');e.style.setProperty('--w',(11+Math.random()*12)+'px');
      e.style.setProperty('--c',C[Math.floor(Math.random()*C.length)]);e.style.setProperty('--sd',(2.5+Math.random()*3)+'s');
      p.appendChild(e);L.appendChild(p);
    }
  }
  function reveal(){
    if(done)return;done=true;
    document.body.classList.remove('locked');window.scrollTo(0,0);
    page.classList.add('show');gate.classList.add('out');startPetals();
    setTimeout(function(){gate.remove();},1800);
  }
  function finish(){gate.classList.add('go');at(1500,reveal);}

  var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  if(reduce){reveal();}
  else{
    at(500,function(){on('l1',1);});
    at(2900,function(){on('l1',0);});
    at(3500,function(){on('l2',1);});
    at(6300,function(){on('l2',0);});
    at(6900,function(){on('hw',1);});
    at(8100,function(){on('hn',1);});
    at(11000,finish);
  }
  document.getElementById('skip').addEventListener('click',function(){
    timers.forEach(clearTimeout);timers=[];
    if(!done){gate.classList.add('go');at(350,reveal);}
  });

  (async function(){
    var wm=document.getElementById('wm'),wf=document.getElementById('wf'),wl=document.getElementById('wl');
    function note(){wm.textContent='التعليقات متاحة لمن يفتح الدعوة وهو مسجّل الدخول في Claude.';}
    if(!window.claude||!window.claude.use){note();return;}
    var db=null,user=null,uid=null;
    try{db=await claude.use('db');user=await claude.use('user');uid=user?await user.id():null;}catch(e){}
    if(!db||!uid){note();return;}
    wf.hidden=false;
    function render(snap){
      wl.textContent='';
      snap.docs.forEach(function(d){
        var v=d.data()||{};var c=document.createElement('div');c.className='wc';
        var b=document.createElement('b');b.textContent=String(v.name||'').slice(0,40);
        var p=document.createElement('p');p.textContent=String(v.text||'').slice(0,300);
        c.appendChild(b);c.appendChild(p);wl.appendChild(c);
      });
    }
    try{db.collection('comments').orderBy('createdAt','desc').limit(50).onSnapshot(render,function(){wm.textContent='تعذّر تحميل التعليقات.';});}catch(e){}
    wf.addEventListener('submit',async function(ev){
      ev.preventDefault();
      var n=document.getElementById('wn').value.trim(),m=document.getElementById('wt').value.trim();
      if(!n||!m)return;
      var btn=document.getElementById('wb');btn.disabled=true;
      try{await db.doc('comments/'+uid).set({name:n,text:m,createdAt:Date.now()});wm.textContent='وصلت تهنئتك، شكرًا لك. إرسال تهنئة جديدة يستبدل السابقة.';}
      catch(e){wm.textContent='تعذّر الإرسال، حاول مرة أخرى.';}
      btn.disabled=false;
    });
  })();

  var target=new Date(2026,9,29,0,0,0).getTime();
  var nf=function(n){return n.toLocaleString('ar-EG');};
  function tick(){
    var diff=target-Date.now();
    if(diff<=0){document.getElementById('cdTitle').textContent='مبروك للعروسين';document.getElementById('cd').style.display='none';return;}
    var t=Math.floor(diff/1000);
    document.getElementById('d').textContent=nf(Math.floor(t/86400));
    document.getElementById('h').textContent=nf(Math.floor(t%86400/3600));
    document.getElementById('m').textContent=nf(Math.floor(t%3600/60));
    document.getElementById('s').textContent=nf(t%60);
  }
  tick();setInterval(tick,1000);
})();
</script>
</body>
</html>
